<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!--
        The value used to be a timestamp, which is why it was 28sp and bold.
        It now holds whatever the model last answered, so it is sized for
        several lines of prose and clipped rather than allowed to overflow:
        a RemoteViews layout that outgrows its cell is silently cropped by
        the launcher, with no way to scroll it.
    -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:text="@string/app_name"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="6dp"
        android:text="@string/widget_empty"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingExtra="2sp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_type" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="@string/type_instead" android:textColor="@color/accent_text" android:textSize="15sp" android:background="@drawable/chip_bg" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/widget_talk" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="@string/shortcut_voice" android:textColor="@color/accent_text" android:textSize="15sp" android:background="@drawable/chip_bg" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
