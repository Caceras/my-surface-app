<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Launch" parent="Chat">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
    <!--
        The stock DeviceDefault theme draws a title bar with the app name in
        it, and the chat screen draws its own header underneath. Two titles,
        one above the other, is the single thing that made the screen look
        unfinished. This turns the system one off and keeps everything else
        the platform gives us, including day/night.
    -->
    <style name="Chat" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:alertDialogTheme">@style/SurfaceDialog</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/chat_bg</item>
    </style>
    <style name="VoiceOverlay" parent="Chat">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <!--
        The phone assistant floats over another app as one frosted sheet. A
        floating translucent window is sized to its content, so Android blurs
        only what is behind the sheet, not the whole screen.
    -->
    <style name="AssistantSheet" parent="Chat">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowElevation">0dp</item>
    </style>
    <style name="SurfaceDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:colorBackground">@color/composer_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
