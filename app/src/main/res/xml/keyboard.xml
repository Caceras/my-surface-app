<?xml version="1.0" encoding="utf-8"?>
<!--
    Ægentica keys: listed in Android's keyboard picker and in Settings → Languages with a Svenska
    (å ä ö) and an English (US) layout. Both type plain ASCII too, so Android may use it in any field.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/keyboard_subtype_sv"
        android:imeSubtypeLocale="sv_SE"
        android:languageTag="sv-SE"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
    <subtype
        android:label="@string/keyboard_subtype_en"
        android:imeSubtypeLocale="en_US"
        android:languageTag="en-US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
</input-method>
