<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked for at the moment the microphone is first tapped, never on
         launch. Audio is transcribed on this phone and never written down. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Package visibility, from Android 11. Without these the speech
        recogniser and the text-to-speech engine cannot be resolved and both
        fail to bind, silently, with nothing in the log worth reading.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Chat">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Hands-free. Exported because the launcher process starts it from
            a static shortcut and the tile starts it from outside the app; it
            carries no intent-filter, because every caller names it outright.
        -->
        <activity
            android:name=".VoiceActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".SurfaceTileService"
            android:exported="true"
            android:icon="@drawable/ic_surface"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SurfaceWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.caceras.surfacelab.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
            The worker behind every text-selection action. It is not exported
            and carries no intent-filter of its own: each flavour supplies its
            own <activity-alias> entries, which is what puts one menu item per
            task into the selection popup.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
