# Copy to .env (never commit it) and fill in.
# LiveKit Cloud (free Build plan) → Settings → Keys, or your own livekit-server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Self-hosted livekit-server instead: read its key from its config file
# (mounted read-only) and give the phone the public address.
# LIVEKIT_KEYS_FILE=/livekit/livekit.yaml
# LIVEKIT_PUBLIC_URL=wss://example.se/livekit

# pipeline (any OpenRouter model) or realtime (Gemini Live).
AEGENTICA_MODE=pipeline
OPENROUTER_API_KEY=
# GOOGLE_API_KEY=            # realtime mode only

# Optional overrides (defaults shown).
# AEGENTICA_LLM=google/gemini-3.8-flash
# AEGENTICA_STT=openai/whisper-large-v3
# AEGENTICA_TTS=microsoft/mai-voice-2.1-flash
# AEGENTICA_VOICE=sv-SE-Harper
# AEGENTICA_LANGUAGE=sv

# The phone sends this to get a room ticket. At least 16 random characters,
# e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AEGENTICA_ACCESS_CODE=
